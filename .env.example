# Copy to .env and adjust. Every threshold/weight in backend/app/core/config.py can be overridden here;
# nested groups use a double underscore (e.g. VISIBILITY__LOW_CONTRAST_RATIO=1.6).

# --- infrastructure ---------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://screener:screener@localhost:5433/screener
# STORAGE_DIR=./var                      # uploads / quarantine / previews (never served directly)
LOG_LEVEL=INFO
LOG_JSON=true
MAX_CONCURRENT_JOBS=2
# Host ports (5433 avoids clashing with a locally installed Postgres on 5432)
# DB_PORT=5433  API_PORT=8000  WEB_PORT=3000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- NLP models ---------------------------------------------------------------------------------------
# or sentence-transformers/all-mpnet-base-v2 (768-dim)
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# must match the model (mpnet = 768) → re-run migrations
EMBEDDING_DIM=384
# auto | cpu | cuda | mps
DEVICE=auto
# natural | stopword_removed
SBERT_INPUT=natural

# --- optional, off by default -------------------------------------------------------------------------
# needs tesseract (docker build arg INSTALL_OCR=true)
OCR__ENABLED=false
# needs LibreOffice (docker build arg INSTALL_LIBREOFFICE=true)
DOCX__CONVERT_TO_PDF=false

# --- upload limits ------------------------------------------------------------------------------------
UPLOAD__MAX_FILE_MB=5
UPLOAD__MAX_PAGES=10

# --- visibility engine --------------------------------------------------------------------------------
VISIBILITY__LOW_CONTRAST_RATIO=1.5
VISIBILITY__TINY_FONT_HIDDEN_PT=4
VISIBILITY__TINY_FONT_SUSPICIOUS_PT=6
VISIBILITY__LOW_OPACITY=0.1
VISIBILITY__COVERED_MIN_FRACTION=0.9

# --- scoring ------------------------------------------------------------------------------------------
SCORING__WEIGHT_REQUIREMENTS=0.5
SCORING__WEIGHT_SKILLS=0.3
SCORING__WEIGHT_OVERALL=0.2
SCORING__CALIB_FLOOR=0.25
SCORING__CALIB_CEILING=0.75
SCORING__REQUIREMENT_MET=0.55
SCORING__GAMING_DELTA_THRESHOLD=10

# --- integrity ----------------------------------------------------------------------------------------
INTEGRITY__JD_VERBATIM_RATIO=90
INTEGRITY__JD_BULK_HIGH=0.15
INTEGRITY__JD_BULK_CRITICAL=0.40
INTEGRITY__INJECTION_SEMANTIC_THRESHOLD=0.75
INTEGRITY__NEAR_DUPLICATE_COSINE=0.97
INTEGRITY__DUPLICATE_SCOPE=job

# --- decision -----------------------------------------------------------------------------------------
DECISION__SHORTLIST_SCORE=70
DECISION__REVIEW_SCORE=60
